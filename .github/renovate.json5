// Renovate (GitHub App): PRs for the versions in
// inventories/group_vars/k8s.yml and for GitHub Actions. Minor and patch
// updates automerge once a release is 3 days old, on weekday working hours,
// Sydney time; majors and 0.x wait for review. See CONTRIBUTING.md.
//
// Tracked vars carry a "# renovate:" comment. The held ones (k8s, containerd,
// cilium) are capped with allowedVersions, so only a PR lifting the cap moves
// them; inside the cap they still wait for Dependency Dashboard approval. The
// legacy stack (compose, deploy-service) isn't scanned: it goes at M8.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  timezone: "Australia/Sydney",
  // build(deps): ..., which passes commit-style.
  semanticCommits: "enabled",
  semanticCommitType: "build",
  semanticCommitScope: "deps",
  // Commits through the GitHub API, signed by GitHub: main requires signatures.
  platformCommit: "enabled",
  minimumReleaseAge: "3 days",
  enabledManagers: ["custom.regex", "github-actions"],
  customManagers: [
    {
      customType: "regex",
      description: "Pinned versions in group_vars/k8s.yml, marked with # renovate:",
      managerFilePatterns: ["/^inventories/group_vars/k8s\\.yml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\w+: \"?(?<currentValue>[^\"\\s]+)\"?",
      ],
    },
  ],
  packageRules: [
    {
      description: "Automerge minor and patch, except 0.x (where a minor can break)",
      matchUpdateTypes: ["minor", "patch"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      automergeSchedule: ["* 9-16 * * 1-5"],
    },
    {
      description: "flux_version must match homelab-cluster's gotk-components.yaml",
      matchDepNames: ["fluxcd/flux2"],
      automerge: false,
      prBodyNotes: [
        "Regenerate `clusters/prod/flux-system/gotk-components.yaml` in homelab-cluster with `flux install --export` at this version, in a matching PR.",
      ],
    },
    {
      description: "cloudflared_sha256 has no checksums file: cloudflared-sums.yml commits it from the asset digests, and is a required check",
      matchDepNames: ["cloudflare/cloudflared"],
      prBodyNotes: [
        "`cloudflared-sums` adds the checksum commit to this PR; it merges after that. Keep the version the same as homelab-cluster's cloudflared image.",
      ],
    },
    {
      description: "Held (decision 27): 1.36 is the newest minor in Cilium 1.20's tested matrix. Lift the cap in a PR, then upgrade with cluster.yml",
      matchDepNames: ["kubernetes/kubernetes"],
      allowedVersions: "<1.37.0",
      dependencyDashboardApproval: true,
      automerge: false,
      prBodyNotes: [
        "Held. Stay inside Cilium's tested matrix, then upgrade with `cluster.yml`.",
      ],
    },
    {
      description: "Held (decision 27): a containerd minor is a deliberate cluster.yml upgrade. Lift the cap in a PR",
      matchDepNames: ["containerd/containerd"],
      allowedVersions: "<2.5",
      dependencyDashboardApproval: true,
      automerge: false,
      prBodyNotes: [
        "Held. A new minor goes through `cluster.yml`; patch releases already move with `patch_nodes.yml -e patch_held=true`.",
      ],
    },
    {
      description: "Held at 1.20.1: 1.20.2 needs kernel BTF, which the Raspberry Pi OS kernels lack. Lift the cap in a PR (with homelab-cluster's) once they have it",
      matchDepNames: ["cilium/cilium"],
      allowedVersions: "<=1.20.1",
      dependencyDashboardApproval: true,
      automerge: false,
      prBodyNotes: [
        "Held for kernel BTF. Check `/sys/kernel/btf/vmlinux` on the Pis first. Keep the same as homelab-cluster's Cilium HelmRelease, which upgrades the running cluster; this is the fresh-install seed.",
      ],
    },
  ],
}
