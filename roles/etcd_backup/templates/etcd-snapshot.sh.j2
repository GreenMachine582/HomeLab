#!/bin/bash
# Rendered by Ansible — do not edit directly on the host.
# Source: roles/etcd_backup/templates/etcd-snapshot.sh.j2
#
# Snapshots the kubeadm etcd, checks the file, archives /etc/kubernetes/pki
# alongside it, and keeps the newest {{ etcd_backup_keep }} of each. Silent on success;
# posts to Discord on any failure. Run by homelab-etcd-snapshot.timer.
{% if etcd_backup_target_enabled | bool %}
# Then copies both to the backup drive ({{ etcd_backup_target_dir }}, NFS from
# {{ backup_nfs_name }}) and keeps {{ etcd_backup_target_keep }} there.
{% endif %}
set -Eeuo pipefail

HOST="{{ inventory_hostname }}"
DIR="{{ etcd_backup_dir }}"
KEEP={{ etcd_backup_keep }}
PKI=/etc/kubernetes/pki

notify() {
    curl -sf --max-time 10 \
        -H "Content-Type: application/json" \
        --data-raw "{\"content\": \"$1\"}" \
        "{{ notify_discord_webhook }}" > /dev/null || true
}
trap 'notify "❌ [etcd] Snapshot on $HOST failed at line $LINENO ($(date "+%Y-%m-%d %H:%M:%S")); see journalctl -u homelab-etcd-snapshot"' ERR

umask 077
stamp="$(date +%Y%m%d-%H%M%S)"
snap="$DIR/etcd-$stamp.db"

etcdctl --endpoints=https://127.0.0.1:2379 \
    --cacert="$PKI/etcd/ca.crt" \
    --cert="$PKI/etcd/healthcheck-client.crt" \
    --key="$PKI/etcd/healthcheck-client.key" \
    snapshot save "$snap.part" > /dev/null
mv "$snap.part" "$snap"

# Fails on a truncated or corrupt file; prints hash, revision, keys, size.
etcdutl snapshot status "$snap" --write-out=table

tar -czf "$DIR/pki-$stamp.tar.gz" -C /etc/kubernetes pki

# prune <dir> <glob> <keep>
prune() {
    ls -1t "$1"/$2 2>/dev/null | tail -n +$(($3 + 1)) | xargs -r rm -f --
}
prune "$DIR" 'etcd-*.db' "$KEEP"
prune "$DIR" 'pki-*.tar.gz' "$KEEP"
rm -f "$DIR"/*.part
{% if etcd_backup_target_enabled | bool %}

TARGET="{{ etcd_backup_target_dir }}"
TARGET_KEEP={{ etcd_backup_target_keep }}

# Runs under `if !`, where set -e and the ERR trap are off, so every step
# returns on failure itself. The mountpoint check keeps a missing mount from
# filling laptop-01's own disk; an unreachable server fails the cp (soft).
ship() {
    timeout 60 mountpoint -q "$TARGET" || { echo "$TARGET isn't mounted"; return 1; }
    for f in "etcd-$stamp.db" "pki-$stamp.tar.gz"; do
        timeout 600 cp "$DIR/$f" "$TARGET/$f.part" && mv "$TARGET/$f.part" "$TARGET/$f" || return 1
    done
    timeout 120 etcdutl snapshot status "$TARGET/etcd-$stamp.db" > /dev/null || return 1
    prune "$TARGET" 'etcd-*.db' "$TARGET_KEEP"
    prune "$TARGET" 'pki-*.tar.gz' "$TARGET_KEEP"
    rm -f "$TARGET"/*.part
    echo "Copied to $TARGET; keeping $TARGET_KEEP there."
}

if ! out="$(ship 2>&1)"; then
    # First line only, without quotes or backslashes: it goes into raw JSON.
    reason="$(printf '%s' "$out" | head -n 1 | tr -d '"\\')"
    notify "⚠️ [etcd] Snapshot on $HOST saved locally, but the copy to the backup drive failed ($(date "+%Y-%m-%d %H:%M:%S")): $reason"
    echo "Copy to $TARGET failed: $out" >&2
else
    echo "$out"
fi
{% endif %}

echo "Saved $snap ($(du -h "$snap" | cut -f1)); keeping $KEEP."
