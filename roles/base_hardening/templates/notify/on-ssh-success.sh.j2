#!/bin/bash
# Rendered by Ansible — do not edit directly on the host.
# Source: roles/base_hardening/templates/notify/on-ssh-success.sh.j2
# Persistent daemon: watches journalctl for accepted SSH logins and notifies.
set -euo pipefail

HOST="{{ notify_host | default(inventory_hostname) }}"

# Ansible from the controller is not posted: each playbook run posts one
# summary instead (callback_plugins/run_notify.py). Skipped only when all
# three match: the user, the Ansible key (by fingerprint), and the source
# machine as Tailscale names it. Anything else, or a failed lookup, alerts.
QUIET_USER="{{ notify_quiet_ansible_user | default('homelab') }}"
QUIET_KEY="{{ notify_quiet_ansible_pubkey | default('') }}"
QUIET_FROM="{{ notify_quiet_ansible_from | default('') }}"
QUIET_FP=""
if [ -n "$QUIET_KEY" ] && [ -n "$QUIET_FROM" ]; then
    QUIET_FP="$(printf '%s\n' "$QUIET_KEY" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')" || QUIET_FP=""
fi

# The tailnet machine name for a 100.x address, or nothing.
machine_of() {
    case "$1" in
        100.*) tailscale whois "$1" 2>/dev/null | awk '/^ *Name:/ {print $2; exit}' | cut -d. -f1 || true ;;
    esac
}

notify() {
    local user="$1" from="$2" fp="$3" time="$4"
    local msg="$user logged in to $HOST from $from${fp:+, key $fp}, at $time"

{% if notify_ntfy_url %}
    curl -sf \
      -H "Title: SSH login on $HOST" \
      -H "Priority: high" \
      -H "Tags: key" \
      -d "$msg" \
      "{{ notify_ntfy_url }}" > /dev/null \
    || {% endif %}curl -sf \
      -H "Content-Type: application/json" \
      --data-raw "{\"content\": \"🔑 [SSH Login] $msg\"}" \
      "{{ notify_discord_webhook }}" > /dev/null || true
}

journalctl -fu ssh --output=cat | while read -r line; do
    if echo "$line" | grep -q "Accepted"; then
        USER=$(echo "$line" | grep -oP 'for \K\S+' || true)
        IP=$(echo "$line"   | grep -oP 'from \K\S+' || true)
        FP=$(echo "$line"   | grep -oP 'SHA256:\S+' | head -1 || true)
        TIME=$(date "+%Y-%m-%d %H:%M:%S")
        MACHINE=$(machine_of "$IP")
        if [ -n "$QUIET_FP" ] && [ "$USER" = "$QUIET_USER" ] && [ "$FP" = "$QUIET_FP" ] \
            && [ -n "$MACHINE" ] && [ "$MACHINE" = "$QUIET_FROM" ]; then
            logger -t on-ssh-success "ansible login for $USER from $MACHINE ($IP), not posted" || true
            continue
        fi
        FROM="$IP"
        if [ -n "$MACHINE" ]; then FROM="$MACHINE ($IP)"; fi
        notify "$USER" "$FROM" "$FP" "$TIME"
    fi
done
