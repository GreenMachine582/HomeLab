[Unit]
Description=Wake the site's Wake-on-LAN nodes after boot
After=network-online.target
Wants=network-online.target

[Service]
# exec, not oneshot: polling for up to {{ wol_wake_minutes }} min mustn't hold up boot.
Type=exec
ExecStart={{ wol_script_dir }}/wake-targets.sh

[Install]
WantedBy=multi-user.target
