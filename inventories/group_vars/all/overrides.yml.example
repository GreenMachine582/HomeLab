---
# inventories/group_vars/all/overrides.yml.example
# Template for overrides.yml — copy and fill in real values before running Ansible.
#
#   cp inventories/group_vars/all/overrides.yml.example \
#      inventories/group_vars/all/overrides.yml
#
# overrides.yml is gitignored. This example file is committed as a reference.

lan_subnet: "EDIT_BEFORE_USE"   # e.g. 192.168.1.0/24

github_org: "EDIT_BEFORE_USE"   # e.g. your-github-username-or-org

ip_edge:    "EDIT_BEFORE_USE"   # homelab-edge static DHCP IP
ip_observe: "EDIT_BEFORE_USE"   # homelab-observe static DHCP IP
ip_data_01: "EDIT_BEFORE_USE"   # homelab-data-01 static DHCP IP
ip_svc_01:  "EDIT_BEFORE_USE"   # homelab-svc-01 static DHCP IP
ip_svc_02:  "EDIT_BEFORE_USE"   # homelab-svc-02 static DHCP IP
ip_svc_03:  "EDIT_BEFORE_USE"   # homelab-svc-03 static DHCP IP

ssh_port: 22           # SSH port for all hosts (default: 22)
fallback_ssh_port: 22  # Factory-fresh port before hardening (rarely needs changing)

tailscale_ip_edge:    "EDIT_BEFORE_USE"   # homelab-edge Tailscale IP (100.x.x.x)
tailscale_ip_observe: "EDIT_BEFORE_USE"   # homelab-observe Tailscale IP
tailscale_ip_data_01: "EDIT_BEFORE_USE"   # homelab-data-01 Tailscale IP
tailscale_ip_svc_01:  "EDIT_BEFORE_USE"   # homelab-svc-01 Tailscale IP
tailscale_ip_svc_02:  "EDIT_BEFORE_USE"   # homelab-svc-02 Tailscale IP
tailscale_ip_svc_03:  "EDIT_BEFORE_USE"   # homelab-svc-03 Tailscale IP
                                            # Set once after Tailscale is up on each node
                                            # (run: tailscale status). Leave as EDIT_BEFORE_USE until then.

tailscale_tailnet: "EDIT_BEFORE_USE"   # e.g. mango-beaver — find it under DNS in the Tailscale admin console

# ── Kubernetes nodes (inventories/k8s.yml) ────────────────────────────────────
# Static via roles/node_network at the site (see below).
ip_laptop_01: "EDIT_BEFORE_USE"   # control plane
mac_laptop_01: "EDIT_BEFORE_USE"  # wired NIC, for Wake-on-LAN (ip -br link)
ip_rpi_01:    "EDIT_BEFORE_USE"   # node (Pi 4)
ip_rpi_02:    "EDIT_BEFORE_USE"   # node (Pi 4)
ip_rpi_03:    "EDIT_BEFORE_USE"   # data node (Pi 5 + NVMe)
# First boot of a fresh node only: the DHCP address it has now (from
# playbooks/identify_nodes.yml). The bootstrap reaches it there, then
# node_network moves it to its static ip_*. Delete once bootstrapped.
# dhcp_rpi_01: "192.168.20.x"
# dhcp_rpi_02: "192.168.20.x"

# ── Site network (roles/node_network, docs/K8S_SITE_MOVE.md) ───────────────────
# The site router can't reserve addresses, so nodes get static IPs: pick
# ip_* outside its DHCP pool, set these, then node_network_static: true.
node_network_static: false
lan_gateway: "EDIT_BEFORE_USE"           # site router, e.g. 192.168.20.1
# lan_dns: ["192.168.20.1", "1.1.1.1"]  # default: [lan_gateway, 1.1.1.1]
home_lan_subnet: "EDIT_BEFORE_USE"       # home LAN; must never be advertised from the site
tailscale_subnet_router: false           # true: laptop-01 advertises lan_subnet
# k8s-api on the controller: laptop-01's Tailscale IP. Required (controller.yml
# checks) once node_network_static is true.
# k8s_api_client_ip: "100.x.y.z"
