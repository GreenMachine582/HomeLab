---
# secrets/vault.yml.example
# Template showing all variables required in secrets/vault.yml (Ansible Vault).
#
# DO NOT commit vault.yml — only this example file is committed.
# The vault lives at inventories/group_vars/all/vault.yml so Ansible auto-loads it.
# Create the encrypted vault with:
#   ansible-vault create inventories/group_vars/all/vault.yml --vault-password-file .vault_pass
#
# Variable naming convention: vault_<service>_<field>

# ══════════════════════════════════════════════════════════════════════════════
# Secret naming convention
# ══════════════════════════════════════════════════════════════════════════════
# project: homelab
# environment: production
# folders:
#   /camunda  /n8n  /discord  /greentechhub  /deploy  /network  /semaphore
#   /tailscale
#
# Mapping rule:  vault_<service>_<field>  →  /prod/<service-folder>/<FIELD>
#   e.g. vault_camunda_db_password  →  /prod/camunda/DB_PASSWORD
#
# Full map (seed task, Infisical lookups, and the UI must all agree on this):
#   vault_discord_alerts_webhook      → /prod/discord/ALERTS_WEBHOOK
#   vault_discord_public_key          → /prod/discord/PUBLIC_KEY
#   vault_camunda_db_user             → /prod/camunda/DB_USER
#   vault_camunda_db_password         → /prod/camunda/DB_PASSWORD
#   vault_camunda_admin_user          → /prod/camunda/ADMIN_USER
#   vault_camunda_admin_password      → /prod/camunda/ADMIN_PASSWORD
#   vault_camunda_license_key         → /prod/camunda/LICENSE_KEY
#   vault_n8n_user                    → /prod/n8n/USER
#   vault_n8n_password                → /prod/n8n/PASSWORD
#   vault_n8n_owner_email             → /prod/n8n/OWNER_EMAIL
#   vault_n8n_owner_password          → /prod/n8n/OWNER_PASSWORD
#   vault_n8n_encryption_key          → /prod/n8n/ENCRYPTION_KEY
#   vault_n8n_webhook_secret          → /prod/n8n/WEBHOOK_SECRET
#   vault_greentechhub_db_user        → /prod/greentechhub/DB_USER
#   vault_greentechhub_db_password    → /prod/greentechhub/DB_PASSWORD
#   vault_django_secret_key           → /prod/greentechhub/DJANGO_SECRET_KEY
#   vault_deploy_webhook_secret       → /prod/deploy/WEBHOOK_SECRET
#   vault_github_pat                  → /prod/deploy/GITHUB_PAT
#   vault_semaphore_admin_user        → /prod/semaphore/ADMIN_USER
#   vault_semaphore_admin_password    → /prod/semaphore/ADMIN_PASSWORD
#   vault_network_ip_edge             → /prod/network/IP_EDGE
#   vault_network_ip_observe          → /prod/network/IP_OBSERVE
#   vault_network_ip_svc_01           → /prod/network/IP_SVC_01
#   vault_network_ip_svc_02           → /prod/network/IP_SVC_02
#   vault_network_ip_svc_03           → /prod/network/IP_SVC_03
#   (sourced from overrides.yml, not vault — no vault_ prefix)
#   tailscale_ip_observe              → /prod/network/TAILSCALE_IP_OBSERVE
#   tailscale_ip_svc_01               → /prod/network/TAILSCALE_IP_SVC_01
#   tailscale_ip_svc_02               → /prod/network/TAILSCALE_IP_SVC_02
#   tailscale_ip_svc_03               → /prod/network/TAILSCALE_IP_SVC_03
#   vault_admin_ssh_pubkey            → /prod/network/SSH_ADMIN_PUBKEY
#   vault_homelab_ssh_pubkey          → /prod/network/SSH_HOMELAB_PUBKEY
#   vault_deploy_ssh_pubkey           → /prod/network/SSH_DEPLOY_PUBKEY
#   vault_tailscale_oauth_client_id     → /prod/tailscale/OAUTH_CLIENT_ID
#   vault_tailscale_oauth_client_secret → /prod/tailscale/OAUTH_CLIENT_SECRET

# ══════════════════════════════════════════════════════════════════════════════
# [bootstrap] — read directly by Ansible during Phase 1 (before Infisical exists)
# ══════════════════════════════════════════════════════════════════════════════

# ── Bootstrap credentials ─────────────────────────────────────────────────────
# admin sudo password — set in RPi Imager (BOOTSTRAP.md § 0.3)
# Wired via bootstrap.ini: ansible_become_password={{ vault_admin_become_password }}
vault_admin_become_password: "changeme"

# ── SSH public keys ───────────────────────────────────────────────────────────
vault_admin_ssh_pubkey: "ssh-ed25519 AAAA... admin"
vault_homelab_ssh_pubkey: "ssh-ed25519 AAAA... homelab"
vault_deploy_ssh_pubkey: "ssh-ed25519 AAAA... deploy"

# ── Tailscale ─────────────────────────────────────────────────────────────────
# See BOOTSTRAP.md § 1.8 for setup steps (ACL tag + OAuth client creation).
vault_tailscale_oauth_client_id: "..."
vault_tailscale_oauth_client_secret: "tskey-client-..."

# ── Infisical ─────────────────────────────────────────────────────────────────
vault_infisical_admin_email: "admin@example.com"
vault_infisical_admin_password: "changeme"
# Generate one with: openssl rand -hex 16
vault_infisical_encryption_key: "changeme"

# ── Semaphore admin account ───────────────────────────────────────────────────
vault_semaphore_admin_user: "admin"
vault_semaphore_admin_password: "changeme"

# ══════════════════════════════════════════════════════════════════════════════
# [seed → /prod/<folder>/<KEY>] — application secrets, pushed into Infisical
# by the Phase 1 seed task (additive, create-if-absent).
# ══════════════════════════════════════════════════════════════════════════════

# ── Discord — system notifications (boot/shutdown/SSH) ───────────────────────
# Plain Discord webhook URL used as fallback when ntfy (homelab-observe) is unreachable.
# Create in Discord → Server Settings → Integrations → Webhooks.
# Separate from Alertmanager webhooks (critical/warning/info) — use a dedicated channel.
vault_discord_alerts_webhook: "https://discord.com/api/webhooks/channel_id/token"

# ── PostgreSQL — Camunda (svc-01) ─────────────────────────────────────────────
vault_camunda_db_user: "camunda"
vault_camunda_db_password: "changeme"

# ── Camunda admin + license ───────────────────────────────────────────────────
vault_camunda_admin_user: "admin"
vault_camunda_admin_password: "changeme"
vault_camunda_license_key: ""              # Optional for dev; required for production

# ── n8n ───────────────────────────────────────────────────────────────────────
vault_n8n_user: "admin"
vault_n8n_password: "changeme"
vault_n8n_owner_email: "admin@example.com"
vault_n8n_owner_password: "changeme"
# Generate with: openssl rand -base64 32
vault_n8n_encryption_key: "changeme"

# ── discord-gateway ───────────────────────────────────────────────────────────
# discord-gateway handles INBOUND Discord slash commands routed to n8n workflows.
# Retained; review after Phase 3 to decide if slash-command automation is needed (TODO #34).
# DISCORD_PUBLIC_KEY: Discord Developer Portal → your app → General Information
vault_discord_public_key: "changeme"
# Shared secret validated by discord-gateway when n8n calls back
vault_n8n_webhook_secret: "changeme"

# ── PostgreSQL — GreenTechHub (svc-02) ────────────────────────────────────────
vault_greentechhub_db_user: "greentechhub"
vault_greentechhub_db_password: "changeme"

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
vault_django_secret_key: "changeme"

# ── Deploy webhook ────────────────────────────────────────────────────────────
# GitHub Actions POSTs to the n8n/Camunda webhook with this value in the
# X-Deploy-Secret header; n8n/Camunda validates it before SSHing to the edge.
# Without it any caller who knows the URL can trigger a deploy.
# Must match the DEPLOY_SECRET GitHub Actions secret (repo Settings → Secrets).
vault_deploy_webhook_secret: "changeme"

# ── GitHub PAT (deploy-service private repo clones) ───────────────────────────
vault_github_pat: "github_pat_..."

# ── Network — node IPs ────────────────────────────────────────────────────────
# vault_network_ip_observe: "192.168.50.11"
# vault_network_ip_svc_01:  "192.168.50.20"
# vault_network_ip_svc_02:  "192.168.50.21"
# vault_network_ip_svc_03:  "192.168.50.22"
